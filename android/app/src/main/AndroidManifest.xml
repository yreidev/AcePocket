<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 访问面板 API 必需。flutter create 只在 debug/profile 的 manifest 中加入此权限，
         release 构建必须在此显式声明，否则所有网络请求都会失败。 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 应用内更新调起系统安装器所需（open_filex 自身清单不含此权限）。
         APK 下载到应用私有外部目录的 AcePanel/（FileProvider 已授权的唯一路径），
         经 content URI 交给系统安装器；仅声明此权限，不申请任何存储/媒体权限，
         遵循下方既有的权限最小化原则。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- open_filex 插件的清单会 merge 进以下四个存储/媒体读取权限。
         本应用只用它打开自己下载目录（应用私有外部目录）里的文件，通过 FileProvider
         签发 content URI 即可，完全不需要读取共享存储或媒体库，这里显式移除，
         避免商店审核质疑与用户侧的权限告警面。 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove"/>

    <!-- allowBackup="false"：禁用云备份与设备迁移备份。
         服务器凭据经 flutter_secure_storage（EncryptedSharedPreferences）落盘，
         备份拿到的虽是密文，但密文一旦进入云端即可被离线保存待攻；且主密钥在
         Keystore 中不可导出，恢复到新设备后必然解密失败，只会让用户看到配置
         被静默清空（server_store.dart 对损坏数据的兜底）。备份既有风险又无收益，
         因此直接整体禁用，而不是用 dataExtractionRules/fullBackupContent 做排除。 -->
    <!-- enableOnBackInvokedCallback="true"：启用 Android 13+ 的前置返回调度
         （OnBackInvokedDispatcher），这是预测性返回动画的开关。未开启时系统不会
         把返回手势的进度事件投递给应用，Flutter 默认的
         PredictiveBackPageTransitionsBuilder 会一路退化成普通淡入淡出，
         用户在滑动过程中看不到目的页预览。全项目的返回拦截已统一用 PopScope
         的前置 canPop（见 core/widgets/unsaved_guard.dart），满足该 API 的要求。 -->
    <application
        android:label="AcePocket"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 收窄 open_filex 的 FileProvider 授权范围：插件默认的 filepaths.xml 含
             <root-path path="."/>，可为整个文件系统的任意路径签发 content URI。
             这里用 tools:replace 覆盖其 FILE_PROVIDER_PATHS，只保留应用自己的
             下载目录（transfer_client.dart 的 resolveDownloadDirectory：
             getExternalStorageDirectory()/AcePanel）。 -->
        <provider
            android:name="com.crazecoder.openfile.FileProvider"
            android:authorities="${applicationId}.fileProvider.com.crazecoder.openfile"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/acepocket_file_paths"
                tools:replace="android:resource"/>
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
